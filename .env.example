# Local development: copy to .env.local at the repo root (every app and script reads it).
# Docker (one container): copy to .env next to docker-compose.yml.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: shown as the contact address on /privacy and /terms.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Database (Postgres). In the Docker container leave it empty: Postgres runs inside it.
# Local development: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=flyer postgres:17, then pnpm db:migrate
DATABASE_URL=postgres://postgres:flyer@localhost:5432/postgres

# Sign-in (Better Auth). Generate with: openssl rand -base64 32 (the container makes one if empty).
BETTER_AUTH_SECRET=
# Email sign-in codes are sent with Resend (resend.com). In development without a key the
# code is printed in the server log instead.
RESEND_API_KEY=
EMAIL_FROM="Flyer Studio <login@example.com>"
# Phone numbers typed with a leading 0 are read in this country (263 = Zimbabwe).
DEFAULT_PHONE_COUNTRY=263

# File storage: Cloudflare R2 (or any S3-compatible service). On R2: create two buckets, an
# API token with Object Read & Write, and a custom domain for the public bucket; then run
# pnpm storage:setup (creates missing buckets and the CORS rule the editor needs).
STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
STORAGE_PUBLIC_BUCKET=flyers
STORAGE_PRIVATE_BUCKET=exports
# Public URL of the flyers bucket (its R2 custom domain), no trailing slash.
STORAGE_PUBLIC_URL=https://cdn.example.com

# WhatsApp (apps/whatsapp: whatsapp-web.js on a number dedicated to the studio). The web app
# sends sign-in codes through it; both share INTERNAL_API_SECRET. Inside the container both
# are set automatically. WHATSAPP=off turns the service off.
# The studio number people see (codes come from it). Scan the QR with this phone.
WHATSAPP_NUMBER=+263717726626
WHATSAPP_SERVICE_URL=http://127.0.0.1:3001
INTERNAL_API_SECRET=
# Token for the page that shows the QR code to connect the studio number: /qr?token=...
WHATSAPP_ADMIN_TOKEN=
# Local development only: path to Chrome or Chromium for whatsapp-web.js.
CHROME_PATH=

# Paynow Zimbabwe (paynow.co.zw): Receive Payments > Integrations. Prices live in packages/billing/src/plans.ts.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# While the integration is in test mode: the email of the Paynow merchant account (Paynow only
# completes test payments for it). Remove once the integration is live.
PAYNOW_TEST_AUTH_EMAIL=

# Art director. Claude takes precedence when ANTHROPIC_API_KEY is set; otherwise an open-weight
# model over an OpenAI-compatible API (packages/ai/src/open-model.ts); otherwise the built-in rules.
ANTHROPIC_API_KEY=
# groq (Qwen, free tier) | zai (GLM Flash, free) | deepseek (paid, ~$0.0005 per flyer) | openrouter | ollama | custom
LLM_PROVIDER=
LLM_API_KEY=
# Optional override of the preset model; required for openrouter, ollama and custom.
LLM_MODEL=
# Only for custom, or to override a preset endpoint.
LLM_BASE_URL=
# Optional second provider, tried when the first is rate-limited or down (e.g. zai for free GLM Flash).
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Design critic: a vision model reviews the three directions and keeps fixes it prefers
# side by side (packages/ai/src/critic.ts). It uses the art director's models unless it has its
# own — recommended on free tiers, which meter output per model per minute (Groq free:
# 1,000 tokens/min, most of which the art director spends). Must accept images.
# CRITIC=off disables the review (designs are still lint-checked).
CRITIC=
CRITIC_PROVIDER=
CRITIC_API_KEY=
CRITIC_MODEL=

# Ideogram 4.5 designs the lead direction; Layerize turns its text into editable layers. Paid: prepaid credits at ideogram.ai.
IDEOGRAM_API_KEY=
# low | medium | high — $0.03 / $0.06 / $0.10 per image (any size), plus $0.09 per Layerize call
# (Nov 2026). `pnpm ideogram:quote` prints today's exact prices and margins (free dry run).
IDEOGRAM_QUALITY=medium

# Stock photos for photo frames (https://unsplash.com/developers). Without it, frames stay empty to fill.
UNSPLASH_ACCESS_KEY=

# ── Operations (all optional) ─────────────────────────────────────────────
# Ideogram spend caps per day (the lead falls back to the layout engine beyond them).
IDEOGRAM_DAILY_LIMIT=300
IDEOGRAM_USER_DAILY_LIMIT=40
# Sentry error monitoring: DSN for server + browser; auth token/org/project only for source maps.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# PostHog product analytics (cookieless). Host defaults to https://us.i.posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# debug | info (default)
LOG_LEVEL=
