# Copy to .env.local and fill in. `pnpm supabase status` prints the local Supabase values.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: shown as the contact address on /privacy and /terms.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Must match Supabase → Authentication → Providers → Email → "Email OTP Length".
NEXT_PUBLIC_AUTH_OTP_LENGTH=8

# Stripe (test mode). Price IDs are mapped in lib/stripe/plans.ts.
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_PRO_MONTHLY=price_
STRIPE_PRICE_PRO_ANNUAL=price_
STRIPE_PRICE_MAX_MONTHLY=price_
STRIPE_PRICE_MAX_ANNUAL=price_
# Written by `pnpm stripe:setup`.
STRIPE_PORTAL_CONFIGURATION=

# Art director. Claude takes precedence when ANTHROPIC_API_KEY is set; otherwise an open-weight
# model over an OpenAI-compatible API (lib/design/open-model.ts); otherwise the built-in rules.
ANTHROPIC_API_KEY=
# groq (Qwen, free tier) | zai (GLM Flash, free) | deepseek (paid, ~$0.0005 per flyer) | openrouter | ollama | custom
LLM_PROVIDER=
LLM_API_KEY=
# Optional override of the preset model; required for openrouter, ollama and custom.
LLM_MODEL=
# Only for custom, or to override a preset endpoint.
LLM_BASE_URL=
# Optional second provider, tried when the first is rate-limited or down (e.g. zai for free GLM Flash).
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Ideogram 4.5 designs the lead direction; Layerize turns its text into editable layers. Paid: prepaid credits at ideogram.ai.
IDEOGRAM_API_KEY=
# low | medium | high — price scales with quality.
IDEOGRAM_QUALITY=medium

# Stock photos for photo frames (https://unsplash.com/developers). Without it, frames stay empty to fill.
UNSPLASH_ACCESS_KEY=

# ── Operations (all optional) ─────────────────────────────────────────────
# Ideogram spend caps per day (the lead falls back to the layout engine beyond them).
IDEOGRAM_DAILY_LIMIT=300
IDEOGRAM_USER_DAILY_LIMIT=40
# Sentry error monitoring: DSN for server + browser; auth token/org/project only for source maps.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# PostHog product analytics (cookieless). Host defaults to https://us.i.posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# debug | info (default)
LOG_LEVEL=
