{
  "name": "flyer-studio",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "turbo run dev --filter=@flyer/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @flyer/db generate",
    "db:migrate": "pnpm --filter @flyer/db migrate",
    "db:studio": "pnpm --filter @flyer/db studio",
    "test:db": "pnpm --filter @flyer/db test",
    "test:paynow": "pnpm --filter @flyer/billing test",
    "test:director": "pnpm --filter @flyer/ai test:director",
    "test:ideogram": "pnpm --filter @flyer/ai test:ideogram",
    "test:design": "pnpm --filter @flyer/ai test:design",
    "benchmark": "pnpm --filter @flyer/ai benchmark",
    "director:try": "pnpm --filter @flyer/ai director:try",
    "ideogram:quote": "pnpm --filter @flyer/ai ideogram:quote",
    "audit:contrast": "pnpm --filter @flyer/design audit:contrast",
    "test:export": "pnpm --filter @flyer/web test:export",
    "test:jobs": "pnpm --filter @flyer/web test:jobs",
    "test:generation": "pnpm --filter @flyer/web test:generation",
    "test:whatsapp": "pnpm --filter @flyer/whatsapp test",
    "test:e2e": "pnpm --filter @flyer/web test:e2e",
    "storage:setup": "pnpm --filter @flyer/storage setup",
    "dev:whatsapp": "pnpm --filter @flyer/whatsapp dev",
    "dev:all": "turbo run dev",
    "test:storage": "pnpm --filter @flyer/storage test",
    "admin:grant-pass": "pnpm --filter @flyer/billing grant-pass"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "patchedDependencies": {
      "whatsapp-web.js@1.34.7": "patches/whatsapp-web.js@1.34.7.patch"
    }
  }
}
