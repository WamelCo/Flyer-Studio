{
  "name": "ai-flyer-generator",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:db": "node --experimental-strip-types scripts/test-credits.mts",
    "test:director": "tsx scripts/test-director.mts",
    "test:ideogram": "tsx scripts/test-ideogram.mts",
    "test:jobs": "tsx scripts/test-jobs.mts",
    "test:design": "tsx scripts/test-design.mts",
    "test:generation": "tsx --env-file=.env.local scripts/test-generation.mts",
    "test:e2e": "playwright test",
    "test:stripe": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local scripts/test-stripe-webhooks.mts",
    "director:try": "tsx --env-file=.env.local scripts/try-director.mts",
    "ideogram:quote": "tsx --env-file=.env.local scripts/ideogram-quote.mts",
    "audit:contrast": "tsx scripts/audit-contrast.mts",
    "benchmark": "tsx scripts/benchmark.mts",
    "stripe:setup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local scripts/stripe-setup.mts",
    "stripe:webhooks": "node --env-file=.env.local scripts/stripe-webhooks.mts",
    "supabase": "supabase",
    "stripe": "stripe"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "sharp",
      "supabase",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/nextjs": "^11.11.0",
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.2.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.9.1",
    "konva": "^10.9.1",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "pdf-lib": "^1.17.1",
    "posthog-js": "^1.447.3",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
