{
  "name": "flyer-studio",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @flyer/db db:generate",
    "db:migrate": "pnpm --filter @flyer/db db:migrate",
    "db:deploy": "pnpm --filter @flyer/db db:deploy",
    "db:studio": "pnpm --filter @flyer/db db:studio",
    "test:db": "pnpm --filter @flyer/db test:credits",
    "test:db:concurrency": "pnpm --filter @flyer/db test:concurrency",
    "test:director": "pnpm --filter @flyer/core test:director",
    "director:try": "pnpm --filter @flyer/core director:try",
    "audit:contrast": "pnpm --filter @flyer/core audit:contrast",
    "stripe:setup": "pnpm --filter @flyer/api stripe:setup",
    "stripe:webhooks": "pnpm --filter @flyer/api stripe:webhooks",
    "test:stripe": "pnpm --filter @flyer/api test:stripe",
    "test:render": "pnpm --filter @flyer/core test:render",
    "render:try": "pnpm --filter @flyer/core render:try"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}
