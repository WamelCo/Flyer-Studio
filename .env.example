# Copy to .env at the repo root. One file serves the API, the web app, Prisma and the
# scripts in development, and docker compose in production.

# ── URLs ─────────────────────────────────────────────────────────────────────
# Public URL of the web app (the browser's origin). Auth, OAuth callbacks and Stripe
# return URLs all use it — the API reads it too. In production: https://your-domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where the web server reaches the API. Compose overrides it with http://api:4000.
API_INTERNAL_URL=http://localhost:4000
PORT=4000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Development: any Postgres you can reach — a local install, Neon, Supabase-as-plain-Postgres…
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flyer_studio
# Production (docker compose builds DATABASE_URL from these for its own Postgres):
POSTGRES_USER=flyer
POSTGRES_PASSWORD=
POSTGRES_DB=flyer

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
# 32+ random characters. Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Digits in the emailed sign-in code (6–10).
AUTH_OTP_LENGTH=6
# Optional Google sign-in. Authorised redirect URI:
#   <NEXT_PUBLIC_SITE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Nodemailer over SMTP) ─────────────────────────────────────────────
# Without SMTP_HOST in development, sign-in codes are printed to the API console.
# Production refuses to start a sign-in without it.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); leave empty to infer from the port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Flyer Studio <no-reply@example.com>"

# ── Storage (Cloudflare R2) ──────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public bucket (uploads + thumbnails), served from R2_PUBLIC_URL (r2.dev URL or custom domain).
R2_BUCKET_PUBLIC=flyer-studio-public
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
# Private bucket for finished exports (presigned downloads only).
R2_BUCKET_EXPORTS=flyer-studio-exports

# ── Stripe (test mode in development). Price IDs are mapped in packages/core/src/stripe/plans.ts.
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_PRO_MONTHLY=price_
STRIPE_PRICE_PRO_ANNUAL=price_
STRIPE_PRICE_MAX_MONTHLY=price_
STRIPE_PRICE_MAX_ANNUAL=price_
# Written by `pnpm stripe:setup`.
STRIPE_PORTAL_CONFIGURATION=

# ── Art director ─────────────────────────────────────────────────────────────
# Claude takes precedence when ANTHROPIC_API_KEY is set; otherwise an open-weight model
# over an OpenAI-compatible API (packages/core/src/design/open-model.ts); otherwise the built-in rules.
ANTHROPIC_API_KEY=
# groq (Qwen, free tier) | zai (GLM Flash, free) | deepseek (paid, ~$0.0005 per flyer) | openrouter | ollama | custom
LLM_PROVIDER=
LLM_API_KEY=
# Optional override of the preset model; required for openrouter, ollama and custom.
LLM_MODEL=
# Only for custom, or to override a preset endpoint.
LLM_BASE_URL=
# Optional second provider, tried when the first is rate-limited or down (e.g. zai for free GLM Flash).
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Renderer (optional): Ideogram finishes each engine-designed variant as a polished graphic
# (https://developer.ideogram.ai). Without it, users get the editable engine designs.
IDEOGRAM_API_KEY=
# ideogram-4-5 (default) | ideogram-4
IDEOGRAM_MODEL=
# high (default, ~$0.10/image) | medium (~$0.06/image). Three images per generation.
IDEOGRAM_QUALITY=
# Set to "engine" to turn the renderer off while keeping the key.
RENDERER=

# Stock photos for photo frames (https://unsplash.com/developers). Without it, frames stay empty to fill.
UNSPLASH_ACCESS_KEY=

# Set to "off" to disable the API's daily Free-plan retention purge.
RETENTION_JOB=
